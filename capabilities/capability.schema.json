        },
        "redact_paths": {
          "items": {
            "type": "string"
          },
          "title": "Redact Paths",
          "type": "array"
        }
      },
      "title": "SafetyConstraints",
      "type": "object"
    },
    "SelectAction": {
      "additionalProperties": false,
