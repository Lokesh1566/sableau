            "type": "string"
          },
          "title": "Frame Path",
          "type": "array"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Condition",
      "type": "object"
    },
    "CssLocator": {
      "additionalProperties": false,
      "description": "Last resort. Recorded so replay degrades rather than dies.",
