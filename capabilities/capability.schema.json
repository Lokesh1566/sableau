          "type": "string"
        },
        "condition": {
          "$ref": "#/$defs/Condition"
        },
        "timeout_ms": {
          "default": 8000,
          "title": "Timeout Ms",
          "type": "integer"
        },
        "on_fail_code": {
          "$ref": "#/$defs/ErrorCode",
