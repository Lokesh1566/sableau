        },
        "default": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "example": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Example"
        },
        "sensitivity": {
          "default": "low",
          "enum": [
            "low",
            "medium",
            "secret"
          ],
