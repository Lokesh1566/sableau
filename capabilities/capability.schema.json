          "type": "integer"
        },
        "backoff_ms": {
          "default": 400,
          "title": "Backoff Ms",
          "type": "integer"
        }
      },
      "title": "RetrySpec",
      "type": "object"
    },
    "RoleLocator": {
      "additionalProperties": false,
      "description": "Accessibility role plus accessible name. Preferred: survives restyling.",
      "properties": {
        "strategy": {
          "const": "role",
          "default": "role",
          "title": "Strategy",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "name_equals": {
          "anyOf": [
