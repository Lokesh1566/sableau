        "strategy": {
          "const": "label",
          "default": "label",
          "title": "Strategy",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "exact": {
          "default": true,
          "title": "Exact",
          "type": "boolean"
        },
        "confidence": {
          "default": 0.85,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "text"
      ],
      "title": "LabelLocator",
      "type": "object"
    },
    "NavigateAction": {
      "additionalProperties": false,
