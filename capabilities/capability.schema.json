          "const": "read",
          "default": "read",
          "title": "Type",
          "type": "string"
        },
        "binding": {
          "default": "text",
          "enum": [
            "text",
            "value",
            "attribute",
            "url",
            "count"
          ],
          "title": "Binding",
          "type": "string"
        },
        "attr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attr"
        }
      },
      "title": "ReadAction",
      "type": "object"
    },
    "RecoveryPolicy": {
      "additionalProperties": false,
      "properties": {
        "global_max_retries": {
          "default": 4,
          "title": "Global Max Retries",
          "type": "integer"
        },
        "escalate_on": {
          "items": {
            "$ref": "#/$defs/ErrorCode"
          },
          "title": "Escalate On",
          "type": "array"
        },
        "escalation_mode": {
          "default": "human_handoff",
          "enum": [
            "none",
            "human_handoff"
          ],
          "title": "Escalation Mode",
          "type": "string"
        }
      },
      "title": "RecoveryPolicy",
      "type": "object"
    },
    "RetrySpec": {
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "default": 2,
