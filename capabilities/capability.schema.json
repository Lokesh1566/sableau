          "default": false,
          "title": "Escalate",
          "type": "boolean"
        }
      },
      "title": "OnError",
      "type": "object"
    },
    "OutcomeCategory": {
      "description": "Top level classification returned to the caller.",
      "enum": [
        "SUCCESS",
        "BUSINESS_OUTCOME",
        "RECOVERABLE",
        "HARD_FAILURE"
      ],
      "title": "OutcomeCategory",
      "type": "string"
    },
    "OutcomeResult": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/OutcomeCategory"
