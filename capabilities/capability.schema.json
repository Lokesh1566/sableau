      ],
      "title": "NavigateAction",
      "type": "object"
    },
    "OnError": {
      "additionalProperties": false,
      "properties": {
        "retry": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrySpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
