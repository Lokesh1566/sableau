        "name_matches": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name Matches"
        },
        "confidence": {
          "default": 0.9,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "role"
      ],
