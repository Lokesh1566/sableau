      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "NONE",
        "RECORD_NOT_FOUND",
        "ALREADY_PROCESSED",
        "INVALID_INPUT",
        "VALIDATION_ERROR",
        "PERMISSION_DENIED",
        "CHECKPOINT_MISMATCH",
        "POLICY_VIOLATION",
        "SURFACE_INCOMPATIBLE",
        "ABORTED_BY_OPERATOR",
        "MISSING_CONTROL",
        "AMBIGUOUS_CONTROL",
        "UNEXPECTED_DIALOG",
        "SLOW_LOAD",
        "TRANSIENT_FAILURE",
        "SESSION_EXPIRED"
      ],
