          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "InputSpec",
      "type": "object"
    },
    "KnownOutcome": {
      "additionalProperties": false,
      "description": "A condition the application is *expected* to be able to produce.\n\nKnown outcomes are checked after every step. They are what turns\n'no claims match your search' from a crash into a typed business answer.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "detector": {
          "$ref": "#/$defs/Condition"
        },
        "after_steps": {
          "items": {
            "type": "string"
          },
          "title": "After Steps",
          "type": "array"
        },
        "result": {
          "$ref": "#/$defs/OutcomeResult"
        }
      },
      "required": [
        "id",
        "description",
        "detector",
        "result"
      ],
      "title": "KnownOutcome",
      "type": "object"
    },
    "LabelLocator": {
      "additionalProperties": false,
      "description": "Form control identified by its visible <label>.",
