    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "intent": {
          "title": "Intent",
          "type": "string"
        },
        "action": {
          "discriminator": {
            "mapping": {
              "click": "#/$defs/ClickAction",
              "navigate": "#/$defs/NavigateAction",
              "press": "#/$defs/PressAction",
              "read": "#/$defs/ReadAction",
              "select": "#/$defs/SelectAction",
              "type": "#/$defs/TypeAction",
              "wait": "#/$defs/WaitAction"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NavigateAction"
            },
            {
              "$ref": "#/$defs/ClickAction"
            },
            {
              "$ref": "#/$defs/TypeAction"
            },
            {
              "$ref": "#/$defs/SelectAction"
            },
            {
              "$ref": "#/$defs/PressAction"
            },
            {
              "$ref": "#/$defs/ReadAction"
            },
            {
              "$ref": "#/$defs/WaitAction"
            }
          ],
          "title": "Action"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "risk": {
          "default": "safe",
          "enum": [
            "safe",
            "risky"
          ],
          "title": "Risk",
          "type": "string"
        },
        "preconditions": {
          "items": {
            "type": "string"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "postconditions": {
          "items": {
            "type": "string"
          },
          "title": "Postconditions",
          "type": "array"
        },
        "on_error": {
          "$ref": "#/$defs/OnError"
        },
        "timeout_ms": {
          "default": 8000,
          "title": "Timeout Ms",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "intent",
        "action"
      ],
      "title": "Step",
      "type": "object"
    },
    "SurfaceRequirements": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "dom",
          "enum": [
            "dom",
            "a11y",
            "screenshot",
            "desktop"
          ],
          "title": "Kind",
          "type": "string"
        },
        "required_features": {
          "items": {
            "type": "string"
          },
          "title": "Required Features",
          "type": "array"
        },
        "app_id": {
          "title": "App Id",
          "type": "string"
        },
        "entry_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entry Url"
        }
      },
      "required": [
        "app_id"
      ],
      "title": "SurfaceRequirements",
      "type": "object"
    },
    "TargetSpec": {
      "additionalProperties": false,
      "description": "How to find one control, with ranked fallbacks.",
      "properties": {
        "candidates": {
          "items": {
            "discriminator": {
              "mapping": {
                "css": "#/$defs/CssLocator",
                "label": "#/$defs/LabelLocator",
                "placeholder": "#/$defs/PlaceholderLocator",
                "role": "#/$defs/RoleLocator",
                "testid": "#/$defs/TestIdLocator",
                "text": "#/$defs/TextLocator"
              },
              "propertyName": "strategy"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/RoleLocator"
              },
              {
                "$ref": "#/$defs/TestIdLocator"
              },
              {
                "$ref": "#/$defs/LabelLocator"
              },
              {
                "$ref": "#/$defs/PlaceholderLocator"
              },
              {
                "$ref": "#/$defs/TextLocator"
              },
              {
                "$ref": "#/$defs/CssLocator"
              }
            ]
          },
          "minItems": 1,
          "title": "Candidates",
          "type": "array"
        },
        "frame_path": {
          "items": {
            "type": "string"
          },
          "title": "Frame Path",
          "type": "array"
        },
        "ambiguity_policy": {
          "default": "fail_if_multiple",
          "enum": [
            "fail_if_multiple",
            "first"
          ],
          "title": "Ambiguity Policy",
          "type": "string"
        },
        "verify": {
          "anyOf": [
            {
              "$ref": "#/$defs/VerifySpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "candidates"
      ],
      "title": "TargetSpec",
      "type": "object"
    },
    "TestIdLocator": {
      "additionalProperties": false,
