        },
        "type": {
          "enum": [
            "string",
            "number",
            "boolean"
          ],
          "title": "Type",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/OutputSource"
        },
        "sensitivity": {
          "default": "low",
          "enum": [
            "low",
            "medium",
            "secret"
          ],
          "title": "Sensitivity",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "name",
        "type",
        "source"
      ],
      "title": "OutputSpec",
      "type": "object"
    },
