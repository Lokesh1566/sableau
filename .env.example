# Copy to .env and fill in. .env is gitignored and never read into artifacts.

# Required only for `sableau discover --planner anthropic`.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides.
SABLEAU_MODEL=claude-sonnet-4-6
SABLEAU_POLICY=policy.json
SABLEAU_EVIDENCE=evidence/runs
SABLEAU_CDP_PORT=9222
APP_PORT=8099
