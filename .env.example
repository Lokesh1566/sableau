# Copy to .env and fill in. .env is gitignored and never read into artifacts.

# Required only for `sableau discover --planner anthropic`.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides.
SABLEAU_MODEL=claude-sonnet-4-6
SABLEAU_POLICY=policy-core.json
SABLEAU_EVIDENCE=evidence/runs
SABLEAU_CDP_PORT=9334
SABLEAU_HEADLESS=0

# Public synthetic MERIDIAN demo operators (override for another permitted target).
SABLEAU_OPERATOR=teller1
SABLEAU_SUPERVISOR_OPERATOR=super1
SABLEAU_OPERATOR_PASSWORD=password
SABLEAU_BRANCH=MAIN-001

# Only used by the optional original local claims fixture.
APP_PORT=8099
