        "message": "The session expired. Re-authenticate and invoke the capability again.",
        "capture": null,
        "recovery": "none"
      }
    }
  ],
  "recovery": {
    "global_max_retries": 3,
    "escalate_on": [
      "MISSING_CONTROL",
      "AMBIGUOUS_CONTROL",
      "UNEXPECTED_DIALOG",
      "PERMISSION_DENIED"
    ],
    "escalation_mode": "human_handoff"
  }
}
